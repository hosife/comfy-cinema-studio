# Copy to .env and fill in. .env is ignored by Git. Names only, no values here.

# ComfyUI backend reachable over HTTP.
#   Comfy Cloud:        https://cloud.comfy.org/api
#   Local ComfyUI:      http://127.0.0.1:8188
#   Rented GPU box:     http://<host>:8188
COMFYUI_URL=

# Comfy Cloud only: a workspace API key (sent as X-API-Key). Leave empty for a local ComfyUI.
COMFY_CLOUD_API_KEY=

# Comfy Cloud only, alternative to the key: a Bearer token (sent as Authorization). Prefer the key.
COMFY_CLOUD_AUTH_TOKEN=

# Where uploads and rendered media are written locally (ignored by Git)
OUTPUT_DIR=./outputs

# Where the app listens
APP_HOST=127.0.0.1
APP_PORT=8787
