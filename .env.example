# Copy to .env and fill in. .env is ignored by Git. Names only, no values here.

# ComfyUI backend reachable over HTTP (a Comfy Cloud deployment URL or any ComfyUI host)
COMFYUI_URL=

# Comfy Cloud workspace API key, only if the Comfy Cloud backend is used
COMFY_CLOUD_API_KEY=

# Where generated media is written locally (ignored by Git)
OUTPUT_DIR=./outputs
