# --- secrets: never commit ---------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*token*
*secret*
creds/
credentials/
auth.json
*.credentials.json

# --- generated media and weights: never commit --------------------------
outputs/
output/
renders/
previews/
media/
models/
weights/
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.mp4
*.mov
*.webm
*.mkv
*.gif
*.wav
*.mp3
*.flac
*.png
*.jpg
*.jpeg
*.webp
*.tiff
# small documentation images may be re-included explicitly
!docs/**/*.png

# --- tooling --------------------------------------------------------------
node_modules/
dist/
build/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.log
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.zip
